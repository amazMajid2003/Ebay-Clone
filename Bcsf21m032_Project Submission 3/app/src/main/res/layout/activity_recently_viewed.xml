<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:orientation="horizontal"
        android:padding="@dimen/padding_sdp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="@dimen/margin_sdp_12">

        <ImageView
            android:id="@+id/Cancel_Recentlyviewed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/margin_sdp_10"
            android:layout_weight="0.15"
            android:scaleType="center"
            android:src="@drawable/baseline_arrow_back_24" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.55"
            android:gravity="center"
            android:text="Recently viewed"
            android:textAlignment="textStart"
            android:textColor="@color/black"
            android:textSize="@dimen/textsize_sdp_24"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageViewSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="0.15"
            android:scaleType="center"
            android:src="@drawable/baseline_search_24" />

        <ImageView
            android:id="@+id/imageViewCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.15"
            android:background="@drawable/rounded_corners"
            android:scaleType="center"
            android:src="@drawable/baseline_shopping_cart_24" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView5"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/textsize_sdp_20"
            android:paddingTop="@dimen/textsize_sdp_34"
            android:layout_marginTop="@dimen/margin_sdp_20">

            <ImageView
                android:id="@+id/RecentlyViewdIcon"
                android:layout_width="@dimen/width_sdp_152"
                android:layout_height="@dimen/width_sdp_152"
                android:layout_marginTop="@dimen/margin_sdp_10"
                android:layout_marginBottom="@dimen/margin_sdp_10"
                android:contentDescription="Recently viewed Icon"
                android:src="@drawable/recently_viewed_svgrepo_com" />

            <TextView
                android:id="@+id/MessagesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nothing's here (yet)"
                android:textColor="@color/black"
                android:textSize="@dimen/textsize_sdp_20"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/MessagesText2"
                android:layout_width="@dimen/width_sdp_190"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Once you view some items, they'll show up here"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="@dimen/textsize_sdp_20" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>