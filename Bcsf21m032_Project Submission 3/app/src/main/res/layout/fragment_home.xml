<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    tools:context=".ui.home.HomeFragment">
    <LinearLayout
        android:id="@+id/linearLayoutHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_sdp_65"

        android:orientation="horizontal"

        app:layout_constraintBottom_toTopOf="@+id/scrollViewContent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- eBay Image on the left -->
        <ImageView
            android:id="@+id/imageViewEbay"
            android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:background="@drawable/rounded_corners"
        android:padding="@dimen/padding_sdp_8"
        android:scaleType="centerCrop"
        android:src="@drawable/ebay" /> <!-- Apply rounded corners -->

        <!-- Cart Icon on the right -->
        <ImageView
            android:id="@+id/imageViewCart"
            android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/rounded_corners"
        android:scaleType="center"
        android:src="@drawable/baseline_shopping_cart_24" /> <!-- Apply rounded corners -->
    </LinearLayout>




    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_sdp_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutHeader">

        <LinearLayout
            android:id="@+id/linearLayoutContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_sdp_8">

            <SearchView
                android:id="@+id/searchView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_sdp_16"
                android:background="@drawable/rounded_search_background"
                android:backgroundTint="#E7E4E4"
                android:queryHint="Search on eBay" />

            <HorizontalScrollView
                android:id="@+id/horizontalScrollViewCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_sdp_16"
                android:fillViewport="true"
                android:scrollbars="none"> <!-- Add this line to hide the scrollbar -->

                <LinearLayout
                    android:id="@+id/linearLayoutButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/padding_sdp_5">

                    <Button
                        android:id="@+id/buttonSelling"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/margin_sdp_8"
                        android:background="@drawable/rounded_button"
                        android:text="Selling"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_sdp_12" />

                    <Button
                        android:id="@+id/buttonDeals"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/margin_sdp_8"
                        android:background="@drawable/rounded_button"
                        android:text="Deals"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_sdp_12" />

                    <Button
                        android:id="@+id/buttonCategories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_button"
                        android:text="Categories"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_sdp_12" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/textSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_sdp_20"
                android:text="Sign in so we can personalise your eBay experience"
                android:textAlignment="center"
                android:textColor="#898989"
                android:textSize="@dimen/textsize_sdp_20"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/linearLayoutSignInRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_sdp_16"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_sdp_8"
                    android:background="@drawable/rounded_button"
                    android:text="Register"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_sdp_12" />

                <Button
                    android:id="@+id/buttonSignIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_button"
                    android:text="Sign In"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_sdp_12" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutJustWhenNeeded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_sdp_15"
                android:background="#F4F2F2"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewJustWhenNeededTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_sdp_15"
                    android:text="Just when you needed it most"
                    android:textSize="@dimen/textsize_sdp_20"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewJustWhenNeededDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_sdp_12"
                    android:layout_marginEnd="@dimen/margin_sdp_12"
                    android:text="For your special just-in-time parts, we've got you covered."
                    android:textSize="@dimen/textsize_sdp_16" />

                <Button
                    android:id="@+id/buttonShopNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_sdp_16"
                    android:background="@drawable/rounded_button"
                    android:text="Shop with us Now"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_sdp_12" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/textsize_sdp_24"
                    android:text="Featured Deals"
                    android:textStyle="bold"
                    android:layout_weight="0.75" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="See all"
                    android:textStyle="normal"
                    android:textSize="@dimen/textsize_sdp_18"
                    android:gravity="center"
                    android:layout_weight="0.25"
                    android:paddingEnd="@dimen/margin_sdp_8" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_sdp_8"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_sdp_8">

                        <ImageView
                            android:layout_width="@dimen/width_sdp_120"
                            android:layout_height="@dimen/width_sdp_120"
                            android:src="@drawable/iphone15"
                            />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Apple iPhone 15 "
                            android:textSize="@dimen/textsize_sdp_18"
                            android:gravity="center"
                            android:textAlignment="center"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pro Max 256gb"
                            android:textSize="@dimen/textsize_sdp_18"
                            android:gravity="center"
                            android:textAlignment="center"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="$ 829.99"
                            android:textSize="@dimen/textsize_sdp_18"
                            android:gravity="center"
                            android:textAlignment="center"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="$1,199.00 | 31%off"
                            android:textSize="@dimen/textsize_sdp_16"
                            android:gravity="center"
                            android:textAlignment="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_sdp_8"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_sdp_8">

                        <ImageView
                            android:layout_width="@dimen/width_sdp_120"
                            android:layout_height="@dimen/width_sdp_120"
                            android:src="@drawable/rack"/>                            android:contentDescription="Industrial Work Gloves"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Storage Rack"
                            android:textSize="@dimen/textsize_sdp_18"
                            android:gravity="center"
                            android:textAlignment="center"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="27''W x 59''Hx.."
                            android:textSize="@dimen/textsize_sdp_18"
                            android:gravity="center"
                            android:textAlignment="center"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="$ 37.99"
                            android:textSize="@dimen/textsize_sdp_18"
                            android:gravity="center"
                            android:textAlignment="center"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="$68.99 | 45%off"
                            android:textSize="@dimen/textsize_sdp_16"
                            android:gravity="center"
                            android:textAlignment="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/textsize_sdp_24"
                    android:text="Most Featured Deals"
                    android:textStyle="bold"
                    android:layout_weight="0.75" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="See all"
                    android:textStyle="normal"
                    android:textSize="@dimen/textsize_sdp_18"
                    android:gravity="center"
                    android:layout_weight="0.25"
                    android:paddingEnd="@dimen/margin_sdp_8" />
            </LinearLayout>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_sdp_16">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Card 1 -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_sdp_8"
                        app:cardElevation="4dp"
                        app:cardCornerRadius="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_sdp_8">

                            <ImageView
                                android:layout_width="@dimen/width_sdp_152"
                                android:layout_height="@dimen/width_sdp_152"
                                android:src="@drawable/adidas2"/>                                android:contentDescription="Industrial Work Gloves"/>


                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Adidad Men"
                                android:textSize="@dimen/textsize_sdp_18"
                                android:gravity="center"
                                android:textAlignment="center"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Samosa Shoes"
                                android:textSize="@dimen/textsize_sdp_18"
                                android:gravity="center"
                                android:textAlignment="center"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="$ 40.00"
                                android:textSize="@dimen/textsize_sdp_18"
                                android:gravity="center"
                                android:textAlignment="center"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="$80.00 | 50%off"
                                android:textSize="@dimen/textsize_sdp_16"
                                android:gravity="center"
                                android:textAlignment="center"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Card 2 -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_sdp_8"
                        app:cardElevation="4dp"
                        app:cardCornerRadius="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_sdp_8">

                            <ImageView
                                android:layout_width="@dimen/width_sdp_152"
                                android:layout_height="@dimen/width_sdp_152"
                                android:src="@drawable/slipper"/>                                android:contentDescription="Cat Food Supplies"/>


                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Adidas Men"
                                android:textSize="@dimen/textsize_sdp_18"
                                android:gravity="center"
                                android:textAlignment="center"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Adilette Comfort"
                                android:textSize="@dimen/textsize_sdp_18"
                                android:gravity="center"
                                android:textAlignment="center"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="$ 10.00"
                                android:textSize="@dimen/textsize_sdp_18"
                                android:gravity="center"
                                android:textAlignment="center"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="$13.00 | 20%off"
                                android:textSize="@dimen/textsize_sdp_16"
                                android:gravity="center"
                                android:textAlignment="center"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_sdp_8"
                        app:cardElevation="4dp"
                        app:cardCornerRadius="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_sdp_8">

                            <ImageView
                                android:layout_width="@dimen/width_sdp_152"
                                android:layout_height="@dimen/width_sdp_152"
                                android:src="@drawable/puma"/>                                android:contentDescription="Automotive Care &amp; De..."/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Puma's Men"
                                android:textSize="@dimen/textsize_sdp_18"
                                android:gravity="center"
                                android:textAlignment="center"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Lamelo ball x"
                                android:textSize="@dimen/textsize_sdp_18"
                                android:gravity="center"
                                android:textAlignment="center"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="$ 100.00"
                                android:textSize="@dimen/textsize_sdp_18"
                                android:gravity="center"
                                android:textAlignment="center"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="$169.00 | 35%off"
                                android:textSize="@dimen/textsize_sdp_16"
                                android:gravity="center"
                                android:textAlignment="center"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_sdp_8"
                        app:cardElevation="4dp"
                        app:cardCornerRadius="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_sdp_8">

                            <ImageView
                                android:layout_width="@dimen/width_sdp_152"
                                android:layout_height="@dimen/width_sdp_152"
                                android:src="@drawable/applewatch"/>                                android:contentDescription="Men's Razor Blade"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Apple Watch"
                                android:textSize="@dimen/textsize_sdp_18"
                                android:gravity="center"
                                android:textAlignment="center"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Fitness Pro"
                                android:textSize="@dimen/textsize_sdp_18"
                                android:gravity="center"
                                android:textAlignment="center"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="$ 198.00"
                                android:textSize="@dimen/textsize_sdp_18"
                                android:gravity="center"
                                android:textAlignment="center"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="$299.00 | 43%off"
                                android:textSize="@dimen/textsize_sdp_16"
                                android:gravity="center"
                                android:textAlignment="center"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>




                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
