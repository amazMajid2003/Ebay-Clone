<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.ebay_clone.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_navigation_home_to_navigation_myebay"
            app:destination="@id/navigation_myebay" />
    </fragment>
    <fragment
        android:id="@+id/navigation_myebay"
        android:name="com.example.ebay_clone.ui.myebay.MyebayFragment"
        android:label="@string/title_myeBay"
        tools:layout="@layout/fragment_myebay" >
        <action
            android:id="@+id/action_navigation_myebay_to_navigation_search"
            app:destination="@id/navigation_search" />
        <action
            android:id="@+id/action_navigation_myebay_to_navigation_selling"
            app:destination="@id/navigation_selling" />

    </fragment>
    <fragment
        android:id="@+id/navigation_search"
        android:name="com.example.ebay_clone.ui.search.SearchFragment"
        android:label="@string/title_myeBay"
        tools:layout="@layout/fragment_search" >
        <action
            android:id="@+id/action_navigation_search_to_navigation_notifications"
            app:destination="@id/navigation_notifications" />
    </fragment>
    <fragment
        android:id="@+id/navigation_selling"
        android:name="com.example.ebay_clone.ui.selling.SellingFragment"
        android:label="@string/title_selling"
        tools:layout="@layout/fragment_selling" />
    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.example.ebay_clone.ui.notifications.NotificationsFragment"
        android:label="@string/title_notifications"
        tools:layout="@layout/fragment_notifications" >
        <action
            android:id="@+id/action_navigation_notifications_to_navigation_selling"
            app:destination="@id/navigation_selling" />
    </fragment>

</navigation>