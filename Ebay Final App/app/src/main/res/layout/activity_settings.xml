<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_sdp_8"
    >

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/padding_sdp_8"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/Cancel_Settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.15"
            android:scaleType="center"
            android:src="@drawable/baseline_arrow_back_24" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.55"
            android:text="Settings"
            android:textAlignment="textStart"
            android:textColor="@color/black"
            android:textSize="@dimen/textsize_sdp_24"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Account Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:padding="@dimen/padding_sdp_8"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_sdp_8"
                app:cardCornerRadius="@dimen/margin_sdp_8"
                app:cardElevation="@dimen/margin_sdp_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_sdp_8">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Account"
                        android:textColor="@color/blue"
                        android:textStyle="bold"
                        android:textSize="@dimen/textsize_sdp_24" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Account Details"
                        android:textSize="@dimen/textsize_sdp_20"
                        android:paddingTop="@dimen/padding_sdp_8" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- General Section -->
            <androidx.cardview.widget.CardView
                android:padding="@dimen/padding_sdp_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_sdp_8"
                app:cardCornerRadius="@dimen/margin_sdp_8"
                app:cardElevation="@dimen/margin_sdp_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_sdp_8">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="General"
                        android:textColor="@color/blue"
                        android:textStyle="bold"
                        android:textSize="@dimen/textsize_sdp_24" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Theme"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="@dimen/textsize_sdp_22"
                        android:paddingTop="@dimen/padding_sdp_8" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Use Dark Theme only when your device has Battery Saver enabled"
                        android:textSize="@dimen/textsize_sdp_20"
                        android:paddingTop="@dimen/padding_sdp_5" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Country or region"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="@dimen/textsize_sdp_22"
                        android:paddingTop="@dimen/padding_sdp_8" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="United States"
                        android:textSize="@dimen/textsize_sdp_20"
                        android:paddingTop="@dimen/padding_sdp_5" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Support Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:padding="@dimen/padding_sdp_8"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_sdp_8"
                app:cardCornerRadius="@dimen/margin_sdp_8"
                app:cardElevation="@dimen/margin_sdp_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_sdp_8">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Support"
                        android:textColor="@color/blue"
                        android:textStyle="bold"
                        android:textSize="@dimen/textsize_sdp_24" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Customer Service"
                        android:textSize="@dimen/textsize_sdp_20"
                        android:paddingTop="@dimen/padding_sdp_8" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Shake to report"
                        android:textSize="@dimen/textsize_sdp_20"
                        android:paddingTop="@dimen/padding_sdp_5" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Share Screen with us"
                        android:textSize="@dimen/textsize_sdp_20"
                        android:paddingTop="@dimen/padding_sdp_5" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Additional sections like About, Privacy, etc. can follow the same pattern -->
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>