
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/width_sdp_152"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="8dp"
    card_view:cardElevation="4dp">

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Image for the deal -->
        <ImageView
            android:id="@+id/dealImage"

            android:layout_width="match_parent"
            android:layout_height="@dimen/width_sdp_152"
            android:scaleType="centerCrop" />

        <!-- Name of the deal -->
        <TextView
            android:id="@+id/dealName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deal Name"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingTop="4dp" />

        <!-- Brand -->
        <TextView
            android:id="@+id/dealBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Brand"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray" />

        <!-- Original Price -->
        <TextView
            android:id="@+id/dealPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Price"
            android:textSize="14sp"
            android:textColor="@android:color/holo_red_dark" />

        <!-- Discounted Price -->
        <TextView
            android:id="@+id/dealDiscountedPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Discounted Price"
            android:textSize="14sp"
            android:textColor="@android:color/holo_green_dark"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
